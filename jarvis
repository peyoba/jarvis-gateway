def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="jarvis",
        description="Jarvis Gateway 启动器（ESP32 语音输入与 Mac 控制）",
    )
    parser.add_argument("-c", "--config", metavar="PATH", help="指定配置文件（优先于 JARVIS_CONFIG）")
    sub = parser.add_subparsers(dest="command")

    p_start = sub.add_parser("start", help="启动全部服务")
    p_start.add_argument("--open", action="store_true", help="启动后打开浏览器控制台")
    p_start.add_argument("--no-wait", action="store_true", help="不等待识别模型预热")

    p_restart = sub.add_parser("restart", help="重启全部服务")
    p_restart.add_argument("--open", action="store_true", help="重启后打开控制台")

    sub.add_parser("stop", help="停止全部服务")
    sub.add_parser("status", help="查看服务状态")
    sub.add_parser("open", help="打开浏览器控制台")
    sub.add_parser("doctor", help="环境自检")

    p_logs = sub.add_parser("logs", help="查看日志")
    p_logs.add_argument("which", nargs="?", default="gateway",
                        choices=["gateway", "whisper", "data"])
    p_logs.add_argument("-f", "--follow", action="store_true", help="持续跟踪")

    p_auto = sub.add_parser("autostart", help="开机自启")
    p_auto.add_argument("action", nargs="?", default="status",
                        choices=["on", "off", "status"])

    p_ip = sub.add_parser("ip-sync", help="把网关地址写进开发板")
    p_ip.add_argument("--ip", help="要写入的地址，缺省取本机地址")
    p_ip.add_argument("--port", help="串口设备，缺省自动查找")
    p_ip.add_argument("--force", action="store_true", help="地址没变也重新写入")
    p_ip.add_argument("--json", action="store_true", help="以 JSON 输出")

    p_guard = sub.add_parser("ip-guard", help="网关地址守护")
    p_guard.add_argument("action", nargs="?", default="status",
                         choices=["start", "stop", "status"])

    args = parser.parse_args(argv)
    if args.command == "stop":
        return cmd_stop(config_path=args.config)
    if args.command == "autostart" and args.action in ("off", "status"):
        return cmd_autostart(None, args.action)
    if args.command == "logs":
        return cmd_logs(None, args.which, args.follow)
    if args.command == "ip-sync":
        return cmd_ip_sync(args)
    if args.command == "ip-guard":
        return cmd_ip_guard(args.action)
    try:
        config_path = selected_config_path(args.config)
        cfg = load_config(config_path)
    except (ValueError, OSError):
        print(f"{RED}✗ 配置无效或安全环境变量缺失；拒绝启动，请检查 config.json{RESET}")
        return 1

    if args.command in (None, "start"):
        return cmd_start(cfg,
                         open_panel=getattr(args, "open", False),
                         wait=not getattr(args, "no_wait", False),
                         config_path=config_path)
    if args.command == "restart":
        if cmd_stop(cfg) != 0:
            return 1
        time.sleep(0.8)
        return cmd_start(cfg, open_panel=args.open, wait=True, config_path=config_path)
    if args.command == "status":
        return cmd_status(cfg)
    if args.command == "open":
        open_dashboard(cfg)
        return 0
    if args.command == "autostart":
        return cmd_autostart(cfg, args.action, config_path=config_path)
    if args.command == "doctor":
        return cmd_doctor(cfg, config_path=config_path)

    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
