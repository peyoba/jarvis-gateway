def cmd_start(cfg, open_panel=False, wait=True, config_path=None):
    config_path = selected_config_path(config_path)
    gw_port = int(cfg["gateway"]["port"])
    wh_port = int(cfg["whisper"]["port"])
    for name, port in (("gateway", gw_port), ("whisper", wh_port)):
        record = _managed_record(name)
        if record and record["port"] != port:
            print(f"{RED}✗ 受管 {name} 仍使用旧端口 {record['port']}；请先 stop 或 restart{RESET}")
            return 1  # 不能用新 PID 记录覆盖旧进程，导致旧服务失去管理。
    legacy = _legacy_enabled(cfg)
    ds_port = _data_port(cfg) if legacy else 0
    ping = http_json(f"http://127.0.0.1:{gw_port}/ping")
    gw_online = bool(ping and ping.get("root") == str(ROOT))
    if not gw_online and port_alive(gw_port):
        print(f"{RED}✗ 网关端口 {gw_port} 被其他/未确认进程占用，未终止任何进程{RESET}")
        return 1
    wh_online = port_alive(wh_port)
    if wh_online:
        if _managed_record("whisper") is None:
            print(f"{RED}✗ 识别端口 {wh_port} 被未受管进程占用，未自动接管{RESET}")
            return 1
    if legacy and not gw_online and port_alive(ds_port):
        print(f"{RED}✗ 兼容数据端口 {ds_port} 已被占用{RESET}")
        return 1
    server_bin = Path(os.path.expanduser(cfg["whisper"]["server_bin"]))
    model = Path(os.path.expanduser(cfg["whisper"]["model"]))
    if not wh_online and (not server_bin.is_file() or not model.is_file()):
        print(f"{RED}✗ 缺少 whisper-server 或模型，请运行 ./jarvis doctor{RESET}")
        return 1

    created = []
    complete = False
    try:
        whisper_proc = gateway_proc = None
        if not wh_online:
            print(f"[1/2] 启动识别服务 :{wh_port} ...")
            cmd = [str(server_bin), "-m", str(model), "--host", "127.0.0.1",
                   "--port", str(wh_port), "-l", str(cfg["whisper"].get("language", "zh")),
                   "-bs", str(cfg["whisper"].get("beam_size", 2)), "-nt",
                   "--prompt", str(cfg["whisper"].get("prompt", ""))]
            whisper_proc, _ = spawn(cmd, "whisper_server.log")
            created.append(("whisper", whisper_proc))
            _record_process("whisper", whisper_proc, wh_port)
        if not gw_online:
            print(f"[2/2] 启动网关 :{gw_port} ...")
            env = os.environ.copy()
            env["PYTHONUNBUFFERED"] = "1"
            if config_path is not None:
                env["JARVIS_CONFIG"] = str(config_path)
            gateway_proc, _ = spawn([str(VENV_PY), str(APP_DIR / "jarvis_gateway.py")],
                                     "jarvis_gateway.log", env=env)
            created.append(("gateway", gateway_proc))
            _record_process("gateway", gateway_proc, gw_port)
            def gateway_ready():
                data = http_json(f"http://127.0.0.1:{gw_port}/ping")
                return bool(data and data.get("root") == str(ROOT))
            if wait_for_port(gw_port, 10, "网关", gateway_proc, gateway_ready) is None:
                return 1
        if wait and not wh_online:
            def whisper_ready():
                # whisper.cpp builds differ in health endpoints; a live process
                # accepting TCP plus a non-exited child is the portable gate.
                return port_alive(wh_port)
            if wait_for_port(wh_port, 45, "识别服务", whisper_proc, whisper_ready) is None:
                return 1
        if wait and legacy and wait_for_port(ds_port, 10, "兼容数据端口") is None:
            return 1
        if any(proc.poll() is not None for _, proc in created):
            print(f"{RED}✗ 子服务提前退出{RESET}")
            return 1
        complete = True
        print(f"{GREEN}✓ Jarvis {'已就绪' if wait or wh_online else '网关已启动，识别服务预热中（尚未验收）'}{RESET}")
        print(f"  控制台  {gateway_url(cfg)}")
        if open_panel:
            open_dashboard(cfg)
        return 0
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"{RED}✗ 启动失败: {type(exc).__name__}，回滚本次启动的服务{RESET}")
        return 1
    finally:
        if not complete:
            _rollback(created)


def cmd_stop(cfg=None, config_path=None):
    print("正在停止本项目受管服务 ...")
    # 配置只用于补充端口诊断，失效/移走/缺少鉴权变量不能阻止安全停服。
    if cfg is None:
        try:
            cfg = load_config(config_path)
        except (ValueError, OSError):
            cfg = None
    ports = set()
    if cfg:
        ports.update((int(cfg["gateway"]["port"]), int(cfg["whisper"]["port"])))
    failed = False
    for name, label in (("gateway", "网关"), ("whisper", "识别服务")):
        raw = _read_process_record(name)
        if raw:
            ports.add(raw["port"])  # 包括改配置前的旧端口。
        record = _managed_record(name)
        if record:
            failed |= not _stop_managed(name, record, label)
        elif (RUN_DIR / f"{name}.pid").exists() and (
            raw is None or pid_started(raw["pid"])
        ):
            print(f"{YELLOW}保留 {label} 的未确认进程记录；无法证明属于本项目{RESET}")
            failed = True
    remaining = sorted(p for p in ports if port_alive(p))
    if remaining or failed:
        print(f"{YELLOW}仍有未受管/未退出服务或监听者：{remaining}，未误报全部停止{RESET}")
        return 1
    print(f"{GREEN}✓ 受管服务已停止{RESET}")
    return 0


def fmt_uptime(seconds):
    seconds = max(0, int(seconds))
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes, secs = divmod(rem, 60)
    if days:
        return f"{days}天{hours}小时"
    if hours:
        return f"{hours}小时{minutes}分"
    if minutes:
        return f"{minutes}分{secs}秒"
    return f"{secs}秒"


def cmd_status(cfg):
    gw_port = int(cfg["gateway"]["port"])
    wh_port = int(cfg["whisper"]["port"])
    legacy = _legacy_enabled(cfg)
    ds_port = _data_port(cfg)

    gw_ping = http_json(f"http://127.0.0.1:{gw_port}/ping")
    status = http_json(f"http://127.0.0.1:{gw_port}/status?summary=1",
                       token=cfg["gateway"].get("auth_token", "")) if gw_ping else None

    def line(name, ok, detail):
        mark = f"{GREEN}✓ 在线{RESET}" if ok else f"{RED}✗ 离线{RESET}"
        print(f"  {name:<6} {mark}  {detail}")

    print("Jarvis Gateway 状态")
    print("-" * 58)
    if gw_ping:
        pid = status["gateway"]["pid"] if status else "-"
        up = fmt_uptime(status["gateway"]["uptime"]) if status else "-"
        line("网关", True, f":{gw_port}  PID {pid}  运行 {up}")
    else:
        line("网关", False, f":{gw_port}")

    wh_pids = port_pids(wh_port)
    line("识别", bool(wh_pids), f":{wh_port}" + (f"  PID {wh_pids[0]}" if wh_pids else "  未启动"))

    if legacy:
        ds_pids = port_pids(ds_port)
        line("数据", bool(ds_pids), f":{ds_port}" + (f"  PID {ds_pids[0]}" if ds_pids else "  未启动"))
    else:
        line("数据", True, "已合并进主端口 :%d" % gw_port)

    guard = _ip_guard_alive()
    if guard:
        line("地址", True, f"守护 PID {guard['pid']}  已同步 {_synced_address() or '未记录'}")
    else:
        line("地址", True, f"已同步 {_synced_address() or '未记录'}（守护未运行，可用 jarvis ip-guard start）")

    if status:
        print("-" * 58)
        mode = status["gateway"]["mode"]
        tokens = status["data"].get("tokens_str", "--")
        weather = status["data"].get("weather", "--")
        print(f"  模式    {mode}")
        print(f"  Token   {tokens}")
        print(f"  天气    {weather}")
        print(f"  对话    {status['stats']['turns']} 轮（本次启动）")
        print(f"  面板    {gateway_url(cfg)}")
    return 0 if gw_ping else 1


def open_dashboard(cfg):
    url = gateway_url(cfg)
    print(f"打开控制台 {url}")
    subprocess.run(["open", url], check=False)


def cmd_logs(cfg, which, follow):
    mapping = {
        "gateway": "jarvis_gateway.log",
        "whisper": "whisper_server.log",
        # Data collection is embedded in the gateway process now.
        "data": "jarvis_gateway.log",
    }
    if which not in mapping:
        print(f"可用日志：{', '.join(mapping)}")
        return 1
    path = LOG_DIR / mapping[which]
    if not path.exists():
        print(f"日志还不存在：{path}")
        return 1
    cmd = ["tail", "-n", "100"]
    if follow:
        cmd.append("-f")
    cmd.append(str(path))
    os.execvp("tail", cmd)


def _ip_guard_pidfile():
    return RUN_DIR / "ip_guard.pid"


def _ip_guard_alive():
    """返回仍在运行的 IP 守护记录；PID 复用或程序不符时视为没运行。"""
    try:
        record = json.loads(_ip_guard_pidfile().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(record, dict):
        return None
    pid = record.get("pid")
    if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 1:
        return None
    command = pid_command(pid)
    if "jarvis_gateway.ip_sync" not in command or "guard" not in command:
        return None
    return record


def _synced_address():
    try:
        return (RUN_DIR / "gateway_ip.txt").read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def cmd_ip_sync(args):
    """子进程跑 ip_sync：真实串口操作放在服务用的解释器里，启动器本身保持纯标准库。"""
    cmd = [str(VENV_PY), "-m", "jarvis_gateway.ip_sync"]
    if args.ip:
        cmd += ["--ip", args.ip]
    if args.port:
        cmd += ["--port", args.port]
    if args.force:
        cmd.append("--force")
    if args.json:
        cmd.append("--json")
    env = dict(os.environ, PYTHONPATH=str(ROOT / "src"))
    return subprocess.call(cmd, cwd=str(ROOT), env=env)


def cmd_ip_guard(action):
    record = _ip_guard_alive()
    if action == "status":
        if record:
            print(f"IP 守护  {GREEN}✓ 运行中{RESET}  PID {record['pid']}  "
                  f"已同步地址 {_synced_address() or '未记录'}")
            return 0
        print(f"IP 守护  {RED}✗ 未运行{RESET}（地址变化后用 jarvis ip-sync 手动同步）")
        return 1

    if action == "stop":
        if not record:
            print("IP 守护本来就没有在运行")
            return 0
        try:
            os.killpg(record["pid"], signal.SIGTERM)
        except ProcessLookupError:
            pass
        _ip_guard_pidfile().unlink(missing_ok=True)
        print(f"{GREEN}✓ 已停止 IP 守护{RESET}")
        return 0

    if record:
        print(f"IP 守护已在运行（PID {record['pid']}）")
        return 0
    env = dict(os.environ, PYTHONPATH=str(ROOT / "src"))
    proc, log_path = spawn([str(VENV_PY), "-m", "jarvis_gateway.ip_sync", "guard"], "ip_guard.log", env=env)
    RUN_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    payload = {"pid": proc.pid, "started": pid_started(proc.pid), "log": str(log_path)}
    path = _ip_guard_pidfile()
    path.write_text(json.dumps(payload), encoding="utf-8")
    path.chmod(0o600)
    print(f"{GREEN}✓ IP 守护已启动{RESET}（PID {proc.pid}）")
    print(f"  日志  {log_path}")
    return 0


def cmd_autostart(cfg, action, config_path=None):
    if action == "status":
        loaded = subprocess.run(["launchctl", "list"], capture_output=True, text=True)
        present = LABEL in loaded.stdout
        exists = PLIST_PATH.exists()
        print(f"配置文件  {'✓' if exists else '✗'}  {PLIST_PATH}")
        print(f"已加载    {'✓' if present else '✗'}")
        return 0

    if action == "off":
        if PLIST_PATH.exists():
            subprocess.run(["launchctl", "unload", "-w", str(PLIST_PATH)],
                           capture_output=True, text=True)
            try:
                PLIST_PATH.unlink()
            except OSError as e:
                print(f"{YELLOW}配置文件删除失败（{e}），请手动删除：{PLIST_PATH}{RESET}")
                return 1
            print(f"{GREEN}✓ 已关闭开机自启{RESET}")
        else:
            print("本来就没有开启")
        return 0

    # launchd/Finder 不继承交互式 shell。不要把令牌复制进 plist。
    config_path = selected_config_path(config_path)
    if config_path is not None:
        raw = json.loads(config_path.read_text(encoding="utf-8"))
        token = raw.get("gateway", {}).get("auth_token", "")
        for name in re.findall(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}", token):
            result = subprocess.run(["launchctl", "getenv", name], capture_output=True, text=True)
            if not result.stdout.strip():
                print(f"{RED}✗ 自启环境缺少鉴权变量 {name}；未写入/加载自启配置{RESET}")
                print("请使用受保护的配置文件或先配置 launchd 环境；密钥不会写进 plist。")
                return 1
    PLIST_PATH.parent.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    payload = {
        "Label": LABEL,
        "ProgramArguments": [str(VENV_PY), str(ROOT / "jarvis"), "start"],
        "WorkingDirectory": str(ROOT),
        "RunAtLoad": True,
        "KeepAlive": False,
        "StandardOutPath": str(LOG_DIR / "autostart.log"),
        "StandardErrorPath": str(LOG_DIR / "autostart.log"),
        "EnvironmentVariables": {
            "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
            "PYTHONUNBUFFERED": "1",
        },
    }
    if config_path is not None:
        payload["EnvironmentVariables"]["JARVIS_CONFIG"] = str(config_path)

    try:
        with open(PLIST_PATH, "wb") as f:
            plistlib.dump(payload, f)
    except OSError as e:
        fallback = ROOT / "autostart" / f"{LABEL}.plist"
        fallback.parent.mkdir(parents=True, exist_ok=True)
        with open(fallback, "wb") as f:
            plistlib.dump(payload, f)
        print(f"{RED}✗ 无法写入 {PLIST_PATH}（{e}）{RESET}")
        print(f"已把配置文件生成到：{fallback}")
        print("请在该项目目录的「终端」里手动执行：")
        print(f'  cp "{fallback}" ~/Library/LaunchAgents/')
        print(f"  launchctl load -w ~/Library/LaunchAgents/{LABEL}.plist")
        return 1

    subprocess.run(["launchctl", "unload", str(PLIST_PATH)], capture_output=True, text=True)
    result = subprocess.run(["launchctl", "load", "-w", str(PLIST_PATH)],
                            capture_output=True, text=True)
    if result.returncode != 0:
        print(f"{RED}✗ 加载失败：{result.stderr.strip()}{RESET}")
        return 1
    print(f"{GREEN}✓ 已开启开机自启{RESET}（下次登录自动运行）")
    print(f"  {PLIST_PATH}")
    return 0


def cmd_doctor(cfg, config_path=None):
    print("Jarvis 环境自检")
    print("-" * 58)
    ok = True

    def check(label, condition, hint=""):
        nonlocal ok
        print(f"  {'✓' if condition else '✗'} {label}" + (f"  {DIM}{hint}{RESET}" if hint else ""))
        if not condition:
            ok = False

    check("Python venv", VENV_PY.exists(), str(VENV_PY))
    check("网关脚本", (APP_DIR / "jarvis_gateway.py").exists())
    check("控制台页面", (ROOT / "src" / "jarvis_gateway" / "web" / "dashboard.html").exists())
    config_path = selected_config_path(config_path)
    check("配置文件", config_path is not None, str(config_path or CONFIG_PATH))
    check("whisper-server", Path(os.path.expanduser(cfg["whisper"]["server_bin"])).exists(),
          cfg["whisper"]["server_bin"])
    check("Whisper 模型", Path(os.path.expanduser(cfg["whisper"]["model"])).exists(),
          cfg["whisper"]["model"])
    ot_bin = str(cfg["data_service"].get("opentoken_bin", ""))
    has_ot = bool(shutil.which("opentoken") or (ot_bin and Path(os.path.expanduser(ot_bin)).exists()))
    check("opentoken (可选)", has_ot, ot_bin if has_ot else "未安装（将自动启用内置本地估算器）")
    primary = cfg["llm"]["primary"]
    check("主模型配置", bool(primary.get("api_key") and primary.get("base_url")),
          primary.get("name", ""))
    gw = cfg.get("gateway", {})
    if str(gw.get("host", "127.0.0.1")) not in ("127.0.0.1", "localhost", "::1"):
        print(f"  {YELLOW}!{RESET} 网关监听 {gw.get('host')}，若在共享局域网建议设置 gateway.auth_token")
    if gw.get("auth_token"):
        print(f"  {GREEN}✓{RESET} 访问鉴权已开启")
    check("say 命令", bool(subprocess.run(["which", "say"], capture_output=True).stdout))
    check("osascript", bool(subprocess.run(["which", "osascript"], capture_output=True).stdout))

    print("-" * 58)
    print("提示：打字注入还需要在「系统设置 → 隐私与安全性 → 辅助功能」里勾选你的终端。")
    print("全部通过" if ok else "有项目未通过，请按上面的提示处理。")
    return 0 if ok else 1


