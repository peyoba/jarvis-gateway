def main():
    parser = argparse.ArgumentParser(
        prog="jarvis",
        description="Jarvis Gateway 启动器（ESP32 语音输入与 Mac 控制）",
    )
    sub = parser.add_subparsers(dest="command")

    p_start = sub.add_parser("start", help="启动全部服务")
    p_start.add_argument("--open", action="store_true", help="启动后打开浏览器控制台")
    p_start.add_argument("--no-wait", action="store_true", help="不等待识别模型预热")

    p_restart = sub.add_parser("restart", help="重启全部服务")
    p_restart.add_argument("--open", action="store_true", help="重启后打开控制台")

    sub.add_parser("stop", help="停止全部服务")
    sub.add_parser("status", help="查看服务状态")
    sub.add_parser("open", help="打开浏览器控制台")
    sub.add_parser("doctor", help="环境自检")

    p_logs = sub.add_parser("logs", help="查看日志")
    p_logs.add_argument("which", nargs="?", default="gateway",
                        choices=["gateway", "whisper", "data"])
    p_logs.add_argument("-f", "--follow", action="store_true", help="持续跟踪")

    p_auto = sub.add_parser("autostart", help="开机自启")
    p_auto.add_argument("action", nargs="?", default="status",
                        choices=["on", "off", "status"])

    args = parser.parse_args()
    try:
        cfg = load_config()
    except (ValueError, OSError):
        print(f"{RED}✗ 配置无效或安全环境变量缺失；拒绝启动，请检查 config.json{RESET}")
        return 1

    if args.command in (None, "start"):
        return cmd_start(cfg,
                         open_panel=getattr(args, "open", False),
                         wait=not getattr(args, "no_wait", False))
    if args.command == "stop":
        return cmd_stop(cfg)
    if args.command == "restart":
        if cmd_stop(cfg) != 0:
            return 1
        time.sleep(0.8)
        return cmd_start(cfg, open_panel=args.open, wait=True)
    if args.command == "status":
        return cmd_status(cfg)
    if args.command == "open":
        open_dashboard(cfg)
        return 0
    if args.command == "logs":
        return cmd_logs(cfg, args.which, args.follow)
    if args.command == "autostart":
        return cmd_autostart(cfg, args.action)
    if args.command == "doctor":
        return cmd_doctor(cfg)

    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
