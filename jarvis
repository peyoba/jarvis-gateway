def _merge(base, override):
    out = dict(base)
    for key, value in (override or {}).items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = _merge(out[key], value)
        else:
            out[key] = value
    return out


def _legacy_enabled(cfg):
    return bool(cfg.get("gateway", {}).get("enable_legacy_data_port", False))


def _data_port(cfg):
    return int(cfg.get("data_service", {}).get("port", 8080))


def selected_config_path(explicit_path=None):
    """显式路径 > JARVIS_CONFIG > 工程配置 > 标准位置；所有入口复用结果。"""
    src = str(ROOT / "src")
    if src not in sys.path:
        sys.path.insert(0, src)
    from jarvis_gateway.config import find_config_file

    if explicit_path or os.environ.get("JARVIS_CONFIG"):
        return find_config_file(explicit_path)
    return find_config_file(CONFIG_PATH if CONFIG_PATH.is_file() else None)


def load_config(config_path=None):
    """共享安全配置加载器；配置失败必须阻止启动，不回退绕过鉴权。"""
    target = selected_config_path(config_path)
    from jarvis_gateway.config import load_config as shared_load_config

    return shared_load_config(target)


def port_alive(port, host="127.0.0.1", timeout=0.3):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def http_json(url, timeout=1.5, token=""):
    try:
        headers = {"X-Jarvis-Token": token} if token else {}
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None


def port_pids(port):
    try:
        out = subprocess.run(
            ["lsof", "-nP", "-ti", f"tcp:{port}", "-sTCP:LISTEN"],
            capture_output=True, text=True, timeout=5,
        )
        return [int(x) for x in out.stdout.split() if x.strip().isdigit()]
    except Exception:
        return []


def pid_command(pid):
    try:
        out = subprocess.run(
            ["ps", "-p", str(pid), "-o", "command="],
            capture_output=True, text=True, timeout=3,
        )
        return out.stdout.strip()
    except Exception:
        return ""


def pid_started(pid):
    try:
        out = subprocess.run(["ps", "-p", str(pid), "-o", "lstart="],
                             capture_output=True, text=True, timeout=3)
        return out.stdout.strip() if out.returncode == 0 else ""
    except Exception:
        return ""


def _record_process(name, proc, port):
    RUN_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    record = {"pid": proc.pid, "started": pid_started(proc.pid), "port": port}
    path = RUN_DIR / f"{name}.pid"
    path.write_text(json.dumps(record), encoding="utf-8")
    path.chmod(0o600)


def _read_process_record(name):
    try:
        record = json.loads((RUN_DIR / f"{name}.pid").read_text(encoding="utf-8"))
        if not isinstance(record, dict):
            return None
        pid, port = record.get("pid"), record.get("port")
        if (isinstance(pid, bool) or not isinstance(pid, int) or pid <= 1
                or isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535):
            return None
        return record
    except (OSError, ValueError, TypeError):
        return None


def _managed_record(name):
    try:
        record = _read_process_record(name)
        if record is None:
            return None
        pid = record["pid"]
        # PID + 启动时间 + 本项目日志代理路径，共同排除 PID 复用/同名程序。
        command = pid_command(pid)
        if (pid <= 1 or not record.get("started")
                or pid_started(pid) != record["started"]
                or str(ROOT / "src/jarvis_gateway/log_worker.py") not in command
                or str(LOG_DIR / ("jarvis_gateway.log" if name == "gateway" else "whisper_server.log")) not in command):
            return None
        if os.getpgid(pid) != pid:
            return None
        return record
    except (OSError, ValueError, TypeError, KeyError):
        return None


def _stop_managed(name, record, label):
    pid = record["pid"]
    # 在真正发送信号前再次验证，不能仅依赖端口或先前读取的 PID。
    if _managed_record(name) != record:
        return False
    try:
        os.killpg(pid, signal.SIGTERM)
        for _ in range(50):
            if _managed_record(name) != record:
                break
            time.sleep(0.1)
        # 强杀前重新校验，不能凭旧 PID 操作一个后来复用的进程。
        if _managed_record(name) == record:
            os.killpg(pid, signal.SIGKILL)
            for _ in range(10):
                if _managed_record(name) != record:
                    break
                time.sleep(0.1)
    except ProcessLookupError:
        pass
    except OSError:
        print(f"{YELLOW}无法停止 {label}（受管 PID {pid}），请检查进程权限{RESET}")
        return False
    if _managed_record(name) == record:
        print(f"{YELLOW}{label} 尚未退出（受管 PID {pid}）{RESET}")
        return False
    # 若另一个启动器已写入新记录，不能删除它。
    if _read_process_record(name) == record:
        (RUN_DIR / f"{name}.pid").unlink(missing_ok=True)
    print(f"  已停止 {label}（受管 PID {pid}）")
    return True


def stop_port(port, label, expect=()):
    # 只有本次 checkout 记录且身份仍匹配的进程组才允许终止。
    # 旧版纯 PID 文件无法证明启动时间，不自动接管。
    record = None
    name = None
    for candidate in ("gateway", "whisper"):
        found = _managed_record(candidate)
        if found and found.get("port") == port:
            name, record = candidate, found
            break
    if record is None:
        if port_alive(port):
            print(f"{YELLOW}保留端口 {port} 上的未受管进程；无法证明属于本项目{RESET}")
        return False
    return _stop_managed(name, record, label)


def wait_for_port(port, timeout, label, proc=None, health=None):
    started = time.monotonic()
    while time.monotonic() - started < timeout:
        if proc is not None and proc.poll() is not None:
            print(f"{RED}  {label} 提前退出{RESET}")
            return None
        if (health() if health else port_alive(port)):
            return time.monotonic() - started
        time.sleep(0.2)
    print(f"{YELLOW}  {label} 在 {timeout}s 内未就绪{RESET}")
    return None


def spawn(cmd, log_name, env=None):
    LOG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    log_path = LOG_DIR / log_name
    wrapper = ROOT / "src" / "jarvis_gateway" / "log_worker.py"
    flag = "--redact" if log_name == "whisper_server.log" else "--plain"
    proc = subprocess.Popen(
        [str(VENV_PY), str(wrapper), str(log_path), flag] + list(cmd),
        cwd=str(ROOT), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True, env=env,
    )
    return proc, log_path


def _rollback(created):
    for name, proc in reversed(created):
        # 仅使用本次 Popen 返回的、尚未回收的进程句柄；不动预先在线组件。
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
                proc.wait(timeout=3)
            except ProcessLookupError:
                pass
        # If the wrapper already exited, do not signal its possibly-reused
        # process-group ID. The child is either gone or must be handled by the
        # next explicit status/stop operation after identity revalidation.
        (RUN_DIR / f"{name}.pid").unlink(missing_ok=True)


def gateway_url(cfg):
    return f"http://127.0.0.1:{cfg['gateway']['port']}/"


